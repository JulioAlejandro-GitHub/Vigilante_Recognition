# Configuración de Base de Datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=secret
DB_DATABASE=Vigilante_2

# Configuración de Logs
LOG_LEVEL=INFO

# Observabilidad
ENABLE_HEALTHCHECK=True
HEALTHCHECK_INTERVAL=60

# Detección de Rostros
FACE_MIN_WIDTH=30
FACE_MIN_HEIGHT=30
FACE_PADDING_PERCENT=0.10

# Filtros de Calidad Facial
ENABLE_FACE_QUALITY_FILTER=True
MIN_BLUR_SCORE=50.0
MIN_FACE_DETECTOR_SCORE=0.6
MIN_QUALITY_SCORE_FOR_MATCHING=0.4
MIN_QUALITY_SCORE_FOR_IDENTITY_UPDATE=0.6

# Thresholds de Reconocimiento
ENABLE_RECOGNITION_CAMERA_SUPPRESSION=True
RECOGNITION_CAMERA_SUPPRESSION_SECONDS=30
INSIGHTFACE_THRESHOLD=0.60
INSIGHTFACE_AMBIGUOUS_THRESHOLD=0.50
DEEPFACE_THRESHOLD=0.60

# Identidades Conocidas
KNOWN_PERSON_THRESHOLD=0.60
KNOWN_IDENTITY_MAX_EMBEDDINGS=5
KNOWN_IDENTITY_USE_CENTROID=True
KNOWN_IDENTITY_REPRESENTATIVE_POLICY="best_quality"
KNOWN_IDENTITY_MATCH_MODE="centroid_plus_topk"

# Re-Identificación Observados
ENABLE_OBSERVED_REID=True
ENABLE_OBSERVED_IDENTITY=True
OBSERVED_IDENTITY_THRESHOLD=0.55
OBSERVED_IDENTITY_MAX_EMBEDDINGS=10
OBSERVED_IDENTITY_MIN_QUALITY=0.50
OBSERVED_IDENTITY_USE_CENTROID=true
OBSERVED_IDENTITY_DUPLICATE_SIMILARITY_THRESHOLD=0.95
OBSERVED_IDENTITY_REPRESENTATIVE_POLICY="best_quality"
OBSERVED_IDENTITY_MATCH_MODE="centroid_plus_topk"
DEFAULT_OBSERVED_RETENTION_POLICY=1_month
ENABLE_OBSERVED_HOUSEKEEPING=True
OBSERVED_HOUSEKEEPING_MODE=archive
OBSERVED_HOUSEKEEPING_BATCH_SIZE=100

# Storage Externo (Vigilante Storage)
STORAGE_ENABLED=True
STORAGE_SERVICE_BASE_URL=http://localhost:8000
STORAGE_UPLOAD_TIMEOUT_SECONDS=10
STORAGE_SOURCE_SERVICE=recognition_service_1
